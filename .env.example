# Create a Mux Video API access token with read/write permissions.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Required when MUX_PLAYBACK_POLICY=signed (recommended for premium video).
MUX_SIGNING_KEY=
# Store the PEM on one line, replacing line breaks with \n.
MUX_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

MUX_PLAYBACK_POLICY=signed
FRONTEND_URL=http://localhost:5173
